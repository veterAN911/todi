<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notification_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_line_1"
        style="@style/TodiNotificationLine" />

    <TextView
        android:id="@+id/notification_line_2"
        style="@style/TodiNotificationLine" />

    <TextView
        android:id="@+id/notification_line_3"
        style="@style/TodiNotificationLine" />

    <TextView
        android:id="@+id/notification_line_4"
        style="@style/TodiNotificationLine" />

    <TextView
        android:id="@+id/notification_line_5"
        style="@style/TodiNotificationLine" />

    <TextView
        android:id="@+id/notification_line_6"
        style="@style/TodiNotificationLine" />

    <TextView
        android:id="@+id/notification_more"
        style="@style/TodiNotificationLine"
        android:textColor="@color/notification_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
